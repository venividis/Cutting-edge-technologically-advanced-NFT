{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/venividis/Cutting-edge-technologically-advanced-NFT/main/schemas/anima-agent-manifest-v1.schema.json",
  "title": "ANIMA agent manifest v1",
  "description": "An ERC-8004 registration-v1 document with integrity-bound ANIMA extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "name",
    "description",
    "image",
    "services",
    "x402Support",
    "active",
    "registrations",
    "anima"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "const": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "format": "uri"
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "x402Support": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/registration"
      }
    },
    "supportedTrust": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "anima": {
      "$ref": "#/$defs/anima"
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "anima": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "agentId"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-fA-F]{40}$"
        },
        "agentId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "transport"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "transport": {
                "enum": [
                  "streamable-http",
                  "stdio",
                  "sse"
                ]
              }
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "amount",
            "token"
          ],
          "properties": {
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "token": {
              "$ref": "#/$defs/address"
            },
            "meter": {
              "$ref": "#/$defs/address"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelId",
            "weightsRoot",
            "attestationKind"
          ],
          "properties": {
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "weightsRoot": {
              "$ref": "#/$defs/bytes32"
            },
            "attestationKind": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "gui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical",
            "contentUri",
            "entrypoint",
            "version"
          ],
          "properties": {
            "canonical": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "contentUri": {
              "type": "string",
              "minLength": 1
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "peerId"
          ],
          "properties": {
            "network": {
              "type": "string",
              "minLength": 1
            },
            "peerId": {
              "type": "string",
              "minLength": 1
            },
            "bootstrap": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "email",
                  "domain",
                  "did",
                  "ens",
                  "social",
                  "meshPeer",
                  "phone",
                  "apiKeyId"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "registry": {
                "$ref": "#/$defs/address"
              }
            }
          }
        },
        "markets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "market",
              "venue",
              "maxLeverageX100"
            ],
            "properties": {
              "market": {
                "type": "string",
                "minLength": 1
              },
              "venue": {
                "$ref": "#/$defs/address"
              },
              "maxLeverageX100": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "endpoint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "agentRegistry"
      ],
      "properties": {
        "agentId": {
          "type": "integer",
          "minimum": 0
        },
        "agentRegistry": {
          "type": "string",
          "pattern": "^[a-z0-9]+:[1-9][0-9]*:0x[0-9a-fA-F]{40}$"
        }
      }
    }
  }
}
