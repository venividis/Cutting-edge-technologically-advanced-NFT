# Testnet RPC endpoints used by hardhat.config.ts and the live-test scripts.
UNICHAIN_SEPOLIA_RPC=
ROBINHOOD_TESTNET_RPC=
BSC_TESTNET_RPC=
BASE_SEPOLIA_RPC=
OP_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC=
SEPOLIA_RPC=

# ANIMA terminal (`npm run anima`) — binding reads the agent on its home chain and
# writes ENS records on Ethereum. Never commit ANIMA_PRIVATE_KEY.
ANIMA_RPC_URL=
ANIMA_CONTRACT=
ANIMA_PRIVATE_KEY=
ENS_RPC_URL=

# Deployer (use only a disposable burner for testnets; use a hardware wallet or KMS
# in production). Never commit a key or reuse one pasted into chat or logs.
DEPLOYER_PRIVATE_KEY=

# Live-test state and generated actor keys. Keep both outside the repository.
ANIMA_DEPLOYMENT=
ANIMA_KEY_DIR=
ANIMA_TOWN_KEYS=

# LayerZero V2 endpoints (per-chain) — see https://docs.layerzero.network/v2/deployments/deployed-contracts
LZ_ENDPOINT=

# Verification
ETHERSCAN_API_KEY=
