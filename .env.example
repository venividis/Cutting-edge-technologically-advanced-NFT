# RPC endpoints
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=

# ANIMA terminal (`npm run anima`) — binding reads the agent on its home chain and
# writes ENS records on Ethereum. Never commit ANIMA_PRIVATE_KEY.
ANIMA_RPC_URL=
ANIMA_CONTRACT=
ANIMA_PRIVATE_KEY=
ENS_RPC_URL=

# Deployer (use a hardware wallet or KMS in production; never commit a key)
DEPLOYER_PRIVATE_KEY=

# LayerZero V2 endpoints (per-chain) — see https://docs.layerzero.network/v2/deployments/deployed-contracts
LZ_ENDPOINT=

# Verification
ETHERSCAN_API_KEY=
